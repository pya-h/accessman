# Server
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/accessman

# Test database (used by npm run test:e2e)
DATABASE_TEST_URL=postgresql://postgres:postgres@localhost:5432/accessman_test

# Security
SECURITY_KEY=your-shared-security-key-here
OPERATOR_KEY=your-operator-level-key-here
ADMIN_APP_NAME=am-panel

# Token defaults
DEFAULT_TOKEN_EXPIRY_DAYS=365
